{
  "name": "bff-project",
  "version": "1.0.0",
  "scripts": {
    "start": "tsx watch src/index.ts",
    "mock:project-api": "ts-node scripts/mock-project-api.ts",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "postbuild": "npm run openapi:extract",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "openapi:extract": "tsx scripts/export-swagger.ts",
    "pretest": "tsc --project tsconfig.test.json",
    "test": "jest",
    "dev": "tsx watch src/index.ts",
    "contracts:generate": "npm run openapi:extract && node scripts/contracts.mjs --generate",
    "contracts:check": "npm run openapi:extract -- --check && node scripts/contracts.mjs --check"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@mairie360/bffs-lib": "2.7.0",
    "@mairie360/core-api-openapi": "2.2.0",
    "@mairie360/project-api-openapi": "1.2.0",
    "axios": "1.21.0",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "js-yaml": "5.5.0"
  }
}
